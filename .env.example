# Copier vers .env.local pour le dev : cp .env.example .env.local

# Clé API Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Expéditeur (domaine pailloteparadise.fr doit être vérifié dans Resend)
RESEND_FROM_EMAIL=La Paillote Paradise <contact@pailloteparadise.fr>

# Boîte qui reçoit les formulaires
CONTACT_TO_EMAIL=contact@pailloteparadise.fr
